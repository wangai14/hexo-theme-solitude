div.needEndHide#nav-music(onclick='sco.handleMusicClick(event)')
  #nav-music-hoverTips
    button#music-prev.music-control-btn(type='button' title=_p('right_menu.music.back') aria-label=_p('right_menu.music.back') onclick='event.stopPropagation(); sco.musicSkipBack()')
      i.fas.fa-backward-step
    button#music-pause.music-control-btn(type='button' title=_p('right_menu.music.stop') aria-label=_p('right_menu.music.stop') onclick='event.stopPropagation(); sco.musicToggle()')
      i.fas.fa-pause
    button#music-play.music-control-btn(type='button' title=_p('right_menu.music.start') aria-label=_p('right_menu.music.start') onclick='event.stopPropagation(); sco.musicToggle()')
      i.fas.fa-play
    button#music-next.music-control-btn(type='button' title=_p('right_menu.music.forward') aria-label=_p('right_menu.music.forward') onclick='event.stopPropagation(); sco.musicSkipForward()')
      i.fas.fa-forward-step

  meting-js(id=theme.capsule.id server=theme.capsule.server type=theme.capsule.type mutex="true" preload="none" theme="var(--efu-main)" data-lrctype="0" order="random" volume=theme.capsule.volume)
